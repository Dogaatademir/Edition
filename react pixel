function getReactSessionId(event) {
  var attributes = (event.data && event.data.checkout && event.data.checkout.attributes) || [];
  var sessionAttr = attributes.find(function(attr) { return attr.key === 'react_session_id'; });
  if (sessionAttr) {
    return sessionAttr.value;
  }
  return 'pixel_fallback_' + Math.random().toString(36).slice(2);
}

function send(sessionId, type, payload) {
  fetch(SUPABASE_URL + '/rest/v1/analytics_events', {
    method: 'POST',
    keepalive: true,
    headers: {
      'Content-Type': 'application/json',
      'apikey': ANON_KEY,
      'Authorization': 'Bearer ' + ANON_KEY,
      'Prefer': 'return=minimal',
    },
    body: JSON.stringify({
      session_id: sessionId,
      type: type,
      payload: payload,
      ts: new Date().toISOString(),
    }),
  });
}

// Siparişteki ürünler (panelde "en çok satan ürünler" için)
function lineItems(checkout) {
  var items = (checkout && checkout.lineItems) || [];
  return items.map(function(item) {
    var variant = item.variant || {};
    var price = item.finalLinePrice || (variant.price ? { amount: variant.price.amount * (item.quantity || 1) } : null);
    return {
      title:    item.title || (variant.product && variant.product.title) || null,
      variant:  variant.title || null,
      quantity: item.quantity || 1,
      total:    price ? Number(price.amount) : null,
    };
  });
}

// Satın Alım Tamamlandı
analytics.subscribe('checkout_completed', function(event) {
  var sessionId = getReactSessionId(event);
  var checkout = event.data && event.data.checkout;

  send(sessionId, 'purchase', {
    orderId:   checkout && checkout.order && checkout.order.id,
    total:     checkout && checkout.totalPrice && checkout.totalPrice.amount,
    currency:  checkout && checkout.totalPrice && checkout.totalPrice.currencyCode,
    itemCount: checkout && checkout.lineItems && checkout.lineItems.length,
    items:     lineItems(checkout),
  });
});
